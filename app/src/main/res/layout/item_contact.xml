<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="13dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="13dp">
        <TextView android:id="@+id/avatar" android:layout_width="46dp" android:layout_height="46dp"
            android:gravity="center" android:text="A" android:textStyle="bold" android:textSize="18sp"
            android:textColor="@color/ink" android:background="@drawable/avatar_bg"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/contactName" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Alex Morgan" android:textColor="@color/ink"
                android:textStyle="bold" android:textSize="15sp"/>
            <TextView android:id="@+id/contactPhone" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="+1 555 0100" android:textColor="@color/muted"
                android:textSize="12sp" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/contactEmail" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="alex@example.com" android:textColor="@color/muted"
                android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/editButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="34dp" android:minWidth="0dp" android:text="Edit"
                android:textSize="11sp" android:insetTop="0dp" android:insetBottom="0dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/deleteButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="34dp" android:minWidth="0dp" android:text="Delete"
                android:textColor="@color/danger" android:textSize="11sp"
                android:insetTop="0dp" android:insetBottom="0dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
